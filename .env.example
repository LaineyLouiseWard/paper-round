# For local runs only: copy to .env (gitignored). On GitHub these are repository secrets.

# Jev, which judges relevance (typesafe.ai)
TYPESAFE_API_KEY=
# Sends the morning email (resend.com, free tier)
RESEND_API_KEY=
# Optional: adds kept papers to Zotero (zotero.org/settings/keys, with write access)
ZOTERO_API_KEY=
# Optional: only for openalex or openalex_search sources (openalex.org, free)
OPENALEX_API_KEY=
# Optional: abstracts for Elsevier journals, which withhold them elsewhere (dev.elsevier.com)
ELSEVIER_API_KEY=
